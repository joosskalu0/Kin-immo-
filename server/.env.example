# ==========================================
# CONFIGURATION DU SERVEUR KINIMMO BACKEND
# ==========================================
PORT=5000
NODE_ENV=production

# ==========================================
# BASE DE DONNÉES MYSQL (Hostinger ou Cloud)
# ==========================================
# Sur Hostinger cPanel / hPanel :
# DB_HOST est généralement 'localhost' ou l'IP fournie par Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_kinimmo
DB_PASSWORD=VotreMotDePasseTresSecurise123!
DB_NAME=u123456789_kinimmo_db

# ==========================================
# SÉCURITÉ AUTHENTIFICATION & TOKENS JWT
# ==========================================
# Générez une chaîne longue et aléatoire pour signer les jetons de session
JWT_SECRET=kinimmo_super_secret_jwt_key_2026_rdc_production_987654321
JWT_EXPIRES_IN=15d

# ==========================================
# CORS & URL DU FRONTEND
# ==========================================
# L'URL où est hébergé votre site web Kinimmo
FRONTEND_URL=https://kinimmo.com
