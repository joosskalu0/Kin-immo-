# ====================================================================
# CONFIGURATION APACHE / HOSTINGER POUR LE FRONTEND KINIMMO (VITE SPA)
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirection HTTPS (Optionnel si géré par Hostinger SSL automatique)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Proxy inverse optionnel si le backend Node.js tourne sur le même serveur (ex: port 5000)
  # Décommentez les lignes suivantes si vous n'utilisez pas de sous-domaine séparé api.votredomaine.com :
  # RewriteRule ^api/(.*)$ http://localhost:5000/api/$1 [P,L]

  # 3. Router toutes les requêtes d'URL vers index.html pour le routage React (/admin, /map, etc.)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# ====================================================================
# SÉCURITÉ & PROTECTION
# ====================================================================
# Empêcher le listing des répertoires
Options -Indexes

# Headers de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ====================================================================
# COMPRESSION GZIP / DEFLATE POUR ACCÉLÉRER LE SITE
# ====================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ====================================================================
# MISE EN CACHE DU NAVIGATEUR POUR LES ASSETS
# ====================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
