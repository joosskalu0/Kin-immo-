{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=server.js --packages=external",
    "postbuild": "node -e \"try { require('fs').copyFileSync('dist/index.html', 'dist/404.html'); } catch(e) {}\"",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/businessRules.test.ts",
    "test:concordance": "tsx --test tests/concordance/apiConcordance.test.ts",
    "test:api": "tsx --test tests/api/routesRbacValidation.test.ts",
    "test:isolation": "tsx --test tests/isolation/orgIsolation.test.ts",
    "test:security": "tsx --test tests/security/security.test.ts",
    "test:e2e": "tsx --test tests/e2e/journeys360.test.ts",
    "test:perf": "tsx --test tests/perf/budgetA11yLighthouse.test.ts",
    "test:all": "npm run test:unit && npm run test:concordance && npm run test:api && npm run test:isolation && npm run test:security && npm run build && npm run test:e2e && npm run test:perf"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
