{
  "entities": {
    "properties": {
      "title": "Properties",
      "description": "Real estate property listings in Kinshasa and RDC",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "period": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "zipCode": { "type": "string" },
        "country": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "area": { "type": "number" },
        "yearBuilt": { "type": "number" },
        "garages": { "type": "number" },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } },
        "videoUrl": { "type": "string" },
        "virtualTourUrl": { "type": "string" },
        "floorPlanUrl": { "type": "string" },
        "customFields": { "type": "object" },
        "privateFields": { "type": "object" },
        "agentId": { "type": "string" },
        "agencyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "viewsCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "price", "type", "status", "city"]
    },
    "customFields": {
      "title": "Custom Fields Definitions",
      "description": "Dynamic custom field configuration for properties",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "label": { "type": "object" },
        "type": { "type": "string" },
        "group": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "unit": { "type": "string" },
        "required": { "type": "boolean" },
        "isPrivate": { "type": "boolean" },
        "showInSearch": { "type": "boolean" },
        "icon": { "type": "string" },
        "defaultValue": { "type": "string" }
      },
      "required": ["key", "type", "group"]
    },
    "leads": {
      "title": "Lead Requests",
      "description": "Contact and tour requests submitted by buyers or renters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "propertyId": { "type": "string" },
        "propertyTitle": { "type": "string" },
        "agentId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhone": { "type": "string" },
        "message": { "type": "string" },
        "requestType": { "type": "string" },
        "tourDate": { "type": "string" },
        "tourTime": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userName", "userEmail", "message"]
    },
    "users": {
      "title": "User Accounts",
      "description": "Admin, agents, owners and clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "agentId": { "type": "string" },
        "agencyName": { "type": "string" },
        "rccmOrNif": { "type": "string" },
        "planId": { "type": "string" },
        "planExpiry": { "type": "string" },
        "twoFactorEnabled": { "type": "boolean" },
        "kinshasaBadgeVerified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "agents": {
      "title": "Agents",
      "description": "Real estate agents profile records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "avatar": { "type": "string font" },
        "agencyId": { "type": "string" },
        "agencyName": { "type": "string" },
        "rating": { "type": "number" },
        "listingsCount": { "type": "number" },
        "bio": { "type": "string" }
      },
      "required": ["name", "email"]
    },
    "systemSettings": {
      "title": "System Settings",
      "description": "Global administration parameters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "platformName": { "type": "string" },
        "commissionRate": { "type": "number" },
        "defaultCurrency": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "adminEmail": { "type": "string" }
      }
    },
    "concierge_requests": {
      "title": "Concierge Requests",
      "description": "Real estate concierge search requests and mandates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "project_type": { "type": "string" },
        "property_type": { "type": "string" },
        "commune": { "type": "string" },
        "quartier": { "type": "string" },
        "budget_min": { "type": "number" },
        "budget_max": { "type": "number" },
        "currency": { "type": "string" },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "parking": { "type": "boolean" },
        "furnished": { "type": "boolean" },
        "services": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "full_name": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["new", "searching", "properties_found", "visit_scheduled", "negotiation", "completed", "cancelled"]
        },
        "assigned_agent_id": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["project_type", "property_type", "commune", "budget_max", "full_name", "phone", "email"]
    },
    "property_visits": {
      "title": "Property Visits",
      "description": "Scheduled concierge property visits with agents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "request_id": { "type": "string" },
        "property_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "visit_date": { "type": "string" },
        "visit_time": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["scheduled", "confirmed", "completed", "cancelled", "rescheduled"]
        },
        "notes": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["request_id", "visit_date", "status"]
    }
  },
  "firestore": {
    "/concierge_requests/{requestId}": {
      "schema": "concierge_requests",
      "description": "Demandes de conciergerie et mandats de recherche immobilière"
    },
    "/property_visits/{visitId}": {
      "schema": "property_visits",
      "description": "Visites de biens planifiées pour les demandes de conciergerie"
    },
    "/properties/{propertyId}": {
      "schema": "properties",
      "description": "Annonces immobilières publiques à Kinshasa"
    },
    "/leads/{leadId}": {
      "schema": "leads",
      "description": "Demandes de contact et d'informations sur les biens"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "Comptes utilisateurs, administrateurs et profils"
    },
    "/agents/{agentId}": {
      "schema": "agents",
      "description": "Profils des agents immobiliers de Kinshasa"
    }
  }
}
